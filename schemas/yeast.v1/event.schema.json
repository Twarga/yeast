{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeast.dev/schemas/yeast.v1/event.schema.json",
  "title": "Yeast v1 Lifecycle Event",
  "description": "One JSON Lines record emitted per lifecycle event when `--json --events` is used.",
  "type": "object",
  "required": ["schema_version", "type", "name", "command", "time"],
  "properties": {
    "schema_version": { "const": "yeast.v1" },
    "type": { "const": "event" },
    "name": {
      "type": "string",
      "enum": [
        "project.loaded",
        "config.validated",
        "image.pulling",
        "image.ready",
        "disk.ready",
        "cloud_init.generated",
        "vm.starting",
        "ssh.waiting",
        "ssh.ready",
        "provision.started",
        "provision.finished",
        "provision.skipped",
        "snapshot.created",
        "restore.started",
        "restore.finished",
        "instance.ready",
        "instance.stopped",
        "instance.destroyed",
        "workflow.completed",
        "workflow.failed"
      ]
    },
    "command": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string" },
    "instance": { "type": "string" },
    "message": { "type": "string" },
    "time": { "type": "string", "format": "date-time" },
    "data": { "type": "object" }
  },
  "additionalProperties": false
}
